---
import { Image } from "astro:assets";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getEntry, render } from "astro:content";
import Clearing from "../../lab/Clearing.astro";
import Layout from "../../lab/Layout.astro";
import Rings from "../../lab/Rings.astro";
import { site } from "../../lab/site";
import { getGames } from "../../lib/games";
import { href } from "../../lib/url";

export const getStaticPaths = (async () =>
  (await getGames()).map((game) => ({
    params: { game: game.id },
    props: { game },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { game } = Astro.props;
const { Content } = await render(game);
const event = await getEntry(game.data.event);
const making = await getEntry("making", game.id);
const story = making && (await render(making));
---

<Layout
  title={`${game.data.title} – ${site.name}`}
  description={game.data.tagline}
>
  <Clearing>
    <header class="game-head">
      <div>
        <h1 class="page-title">{game.data.title}</h1>
        <p class="lead">{game.data.tagline}</p>
        {event && (
          <p class="mt-3">
            Anlass:{" "}
            <a class="text-link" href={href(`/anlaesse/${event.id}/`)}>
              {event.data.title}
            </a>
          </p>
        )}
        <p class="actions">
          <a class="btn btn-primary" href={game.data.playUrl}>
            {game.data.title} spielen
          </a>
          <a class="btn btn-neutral" href={game.data.sourceUrl}>
            Quellcode auf GitHub
          </a>
        </p>
        <p class="mt-4">
          Läuft direkt im Browser auf dem Computer, mit Tastatur oder
          Controller.
        </p>
      </div>
      <div class="frame">
        <Image
          src={game.data.screenshot}
          alt={game.data.screenshotAlt}
          loading="eager"
          widths={[420, 640, 960, 1200]}
          sizes="(min-width: 60rem) 36rem, 94vw"
        />
      </div>
    </header>
    <article class="article prose">
      <Content />
    </article>
  </Clearing>

  {making && story && (
    <>
      <div class="forest forest-band">
        <div class="board signpost">
          <h2 id="entstehung">Wie {game.data.title} entstand</h2>
        </div>
      </div>
      <Clearing labelledby="entstehung">
        <p class="lead">{making.data.intro}</p>
        {making.data.sketches.length > 0 && (
          <div class="sketches">
            {making.data.sketches.map((sketch) => (
              <figure class="sketch">
                <a href={sketch.src.src}>
                  <Image
                    src={sketch.src}
                    alt={sketch.alt}
                    widths={[420, 640, 960]}
                    sizes="(min-width: 60rem) 33rem, 94vw"
                  />
                </a>
                {sketch.caption && <figcaption>{sketch.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        <ol class="trail">
          {making.data.steps.map((step, i) => (
            <li>
              <Rings count={i + 1} />
              <h3>{step.title}</h3>
              <p class="mt-2">{step.text}</p>
              {step.picture && (
                <div class="frame">
                  <Image
                    src={step.picture.src}
                    alt={step.picture.alt}
                    widths={[420, 640, 960]}
                    sizes="(min-width: 48rem) 40rem, 80vw"
                  />
                </div>
              )}
              {step.pitch && (
                <p class="mt-2">
                  <a class="text-link" href={step.pitch}>
                    Pitch lesen
                    <span class="sr-only">: {step.title}</span>
                  </a>
                </p>
              )}
            </li>
          ))}
        </ol>
        <article class="article prose">
          <story.Content />
        </article>
      </Clearing>
    </>
  )}
</Layout>
