---
import { getVariantGames } from "../../lib/games";
import { href } from "../../lib/url";
import GameCard from "../../variants/november-games/GameCard.astro";
import Layout from "../../variants/november-games/Layout.astro";
import meta from "../../variants/november-games/meta";

const games = await getVariantGames();
---

<Layout
  title={meta.name}
  description="Am Nationalen Zukunftstag entwickeln Schülerinnen und Schüler eigene Spiele. Entdecke November Games und spiele direkt im Browser."
>
  <section class="hero-section shell" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="signal-dot" aria-hidden="true"></span> Nationaler
        Zukunftstag / November
      </p>
      <h1 id="intro-title">
        Im November
        <br />
        bauen wir
        <br />
        <span class="text-primary">Zukunft.</span>
      </h1>
      <p class="hero-addition">Und Spiele.</p>
      <p class="intro-text">
        Von der 5. Primarklasse bis zur 1. Oberstufe: Am Nationalen Zukunftstag
        machen wir aus unseren Ideen eigene Spiele. Bereit, sie auszuprobieren?
      </p>
      <div class="action-row">
        <a class="btn btn-primary" href={href(`/${meta.slug}/#spiele`)}>
          Spiele entdecken <span aria-hidden="true">↘</span>
        </a>
        <a class="text-link" href={href(`/${meta.slug}/ueber-uns/`)}>
          Unsere Geschichte <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <aside class="landscape-caption" aria-label="Hintergrundillustration">
      <p class="eyebrow">Mythen × Einsiedeln</p>
      <p class="landscape-note">Unsere Region, neu gezeichnet.</p>
      <p class="landscape-note">Gipfel und Höhen: © swisstopo</p>
    </aside>
  </section>
  <section
    id="spiele"
    class="games-section shell"
    aria-labelledby="games-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Ideen werden spielbar</p>
        <h2 id="games-title">
          Dein nächstes Spiel<span class="text-primary">.</span>
        </h2>
      </div>
      <p>
        Entstanden am Zukunftstag 2026.
        <br />
        Direkt im Browser. Ohne Installation.
      </p>
    </div>
    <p class="keyboard-hint" data-enhanced hidden>
      <kbd>Tab</kbd> wählt einen Link · <kbd>← →</kbd> wechseln das Spiel ·{" "}
      <kbd>Enter</kbd> öffnet es
    </p>
    <div class="games-grid">
      {games.map((game, index) => (
        <GameCard game={game} index={index} />
      ))}
    </div>
    <p class="games-note">
      <span aria-hidden="true">↳</span> Zum Spielen brauchst du einen Computer
      mit Tastatur oder Controller.
    </p>
  </section>
  <section class="mission-section shell" aria-labelledby="mission-title">
    <p class="eyebrow">Unser Motto</p>
    <div class="mission-content">
      <h2 id="mission-title">
        Spiele entwickeln.
        <br />
        <span>Die Welt retten.</span>
      </h2>
      <div>
        <p>
          Grosse Worte? Klar. Aber jede Zukunft beginnt mit einer Idee. Wir
          fangen mit unseren eigenen Spielen an.
        </p>
        <a class="text-link" href={href(`/${meta.slug}/ueber-uns/`)}>
          Lerne uns kennen <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
