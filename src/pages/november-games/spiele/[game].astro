---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import { getVariantGames } from "../../../lib/games";
import { href } from "../../../lib/url";
import Layout from "../../../variants/november-games/Layout.astro";
import meta from "../../../variants/november-games/meta";
import GameArtwork from "../../../variants/november-games/GameArtwork.astro";
import GamePreview from "../../../variants/november-games/GamePreview.astro";

export const getStaticPaths = (async () =>
  (await getVariantGames()).map((game) => ({
    params: { game: game.id },
    props: { game },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { game } = Astro.props;
const { Content } = await render(game);
---

<Layout
  title={`${game.data.title} – ${meta.name}`}
  description={game.data.tagline}
>
  <div class="game-page shell">
    <a class="text-link back-link" href={href(`/${meta.slug}/#spiele`)}>
      <span aria-hidden="true">←</span> Alle Spiele
    </a>
    <header class="game-heading">
      <p class="eyebrow">November Games / Unsere Spiele</p>
      <h1>
        {game.data.title}
        <span class="text-primary">.</span>
      </h1>
      <p class="intro-text">{game.data.tagline}</p>
    </header>
    <GamePreview game={game.id} />
    <div class="game-detail-grid">
      <aside class="play-panel" aria-label={`${game.data.title} starten`}>
        <GameArtwork game={game.id} />
        <p class="eyebrow">Bereit zum Spielen?</p>
        <p class="play-panel-title">Dein nächster Versuch beginnt hier.</p>
        <a class="btn btn-primary" href={game.data.playUrl}>
          {game.data.title} spielen <span aria-hidden="true">↗</span>
        </a>
        <p>
          Direkt im Browser auf dem Computer. Mit Tastatur oder Controller, ohne
          Installation.
        </p>
        <a class="text-link" href={game.data.sourceUrl}>
          Quellcode auf GitHub <span aria-hidden="true">↗</span>
        </a>
      </aside>
      <article class="game-content prose prose-lg">
        <Content />
      </article>
    </div>
  </div>
</Layout>
