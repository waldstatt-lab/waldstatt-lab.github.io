---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import { getVariantGames } from "../../../lib/games";
import { href } from "../../../lib/url";
import Building from "../../../variants/egg-settlers/Building.astro";
import { buildingFor } from "../../../variants/egg-settlers/buildings";
import CarPractice from "../../../variants/egg-settlers/CarPractice.astro";
import Layout from "../../../variants/egg-settlers/Layout.astro";
import meta from "../../../variants/egg-settlers/meta";
import MotoPractice from "../../../variants/egg-settlers/MotoPractice.astro";

export const getStaticPaths = (async () =>
  (await getVariantGames()).map((game) => ({
    params: { game: game.id },
    props: { game },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { game } = Astro.props;
const { Content } = await render(game);
---

<Layout
  title={`${game.data.title} – ${meta.name}`}
  description={game.data.tagline}
>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <a class="btn-game btn-stone" href={href(`/${meta.slug}/#spiele`)}>
      Alle Spiele
    </a>

    <section class="stone mt-6 grid gap-6 p-5 md:grid-cols-2">
      <div class="frame building self-start">
        <Building kind={buildingFor(game.id)} />
      </div>
      <div class="flex flex-col">
        <p class="kicker text-yolk">Gebäude-Info</p>
        <h1 class="display text-4xl sm:text-5xl">{game.data.title}</h1>
        <p class="mt-3 text-lg">{game.data.tagline}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-game btn-meadow btn-big" href={game.data.playUrl}>
            {game.data.title} spielen
          </a>
          <a class="btn-game btn-stone btn-big" href={game.data.sourceUrl}>
            Quellcode auf GitHub
          </a>
        </div>
        <p class="mt-4 text-sm">
          Läuft in einem aktuellen Browser auf dem Computer, mit Tastatur oder
          Controller.
        </p>
      </div>
    </section>

    {game.id === "moto-devil" && <MotoPractice />}
    {game.id === "car-drive" && <CarPractice />}

    <article class="parchment prose prose-lg prose-stone mt-10 max-w-none p-6">
      <Content />
    </article>
  </div>
</Layout>
