---
import Clearing from "../lab/Clearing.astro";
import Flask from "../lab/Flask.astro";
import GameBoard from "../lab/GameBoard.astro";
import Layout from "../lab/Layout.astro";
import WaldstattHint from "../lab/WaldstattHint.astro";
import { site } from "../lab/site";
import { getHeldEvents, getPlannedEvents } from "../lib/events";
import { getEventGames } from "../lib/games";
import { href } from "../lib/url";

const events = await Promise.all(
  (await getHeldEvents()).map(async (event) => ({
    event,
    games: await getEventGames(event.id),
  })),
);
const planned = await getPlannedEvents();
/** Where «Spiele» leads: the newest event with games. */
const firstWithGames = events.findIndex(({ games }) => games.length > 0);
---

<Layout title={site.name} home>
  <div class="hero">
    <div class="hero-inner">
      <div>
        <h1>{site.name}</h1>
        <p class="tagline">
          Technik entdecken.
          <br />
          Ideen ausprobieren.
        </p>
        <p class="actions">
          <a class="btn btn-primary" href="#spiele">
            Zu den Spielen
          </a>
          <a class="btn btn-neutral" href="#lab">
            Was ist das Lab?
          </a>
        </p>
      </div>
      <Flask />
    </div>
  </div>

  <Clearing id="lab" labelledby="lab-title">
    <h2 id="lab-title" class="section-title">
      Was ist das Waldstatt-Lab?
    </h2>
    <dl class="name-parts">
      <div>
        <dt>Waldstatt</dt>
        <dd>
          So hiess Einsiedeln früher. Der heutige Bezirk war die «Waldstatt
          Einsiedeln», seine Bewohner waren die «Waldleute». Wer hier leben
          wollte, musste zuerst eine Lichtung schlagen.
        </dd>
      </div>
      <div>
        <dt>Lab</dt>
        <dd>
          Unser Platz zum Ausprobieren. Wir experimentieren mit Technik und
          bauen Dinge, um zu sehen, ob sie funktionieren. Zum Beispiel am
          Zukunftstag, wo aus Skizzen auf Papier richtige Spiele wurden.
        </dd>
      </div>
    </dl>
    <p class="actions">
      <a class="text-link" href={href("/ueber-uns/")}>
        Mehr über das Lab
      </a>
    </p>
  </Clearing>

  {events.map(({ event, games }, i) => (
    <>
      <div
        class="forest forest-band"
        id={i === firstWithGames ? "spiele" : undefined}
      >
        <div class="board signpost">
          <h2 id={event.id}>
            <a href={href(`/anlaesse/${event.id}/`)}>{event.data.title}</a>
          </h2>
          <p>
            {[event.data.when, event.data.place].filter(Boolean).join(", ")}
          </p>
        </div>
      </div>
      <Clearing labelledby={event.id}>
        <p class="lead">{event.data.summary}</p>
        <p class="actions">
          <a class="text-link" href={href(`/anlaesse/${event.id}/`)}>
            Mehr zum Anlass
          </a>
        </p>
        {games.length > 0 && (
          <div class="games">
            {games.map((game) => (
              <GameBoard game={game} />
            ))}
          </div>
        )}
        <WaldstattHint games={games} />
      </Clearing>
    </>
  ))}

  {planned.map((event) => (
    <div class="forest forest-band">
      <div class="board signpost">
        <h2>{event.data.title}</h2>
        <p>{event.data.when}</p>
        <p>{event.data.summary}</p>
      </div>
    </div>
  ))}
</Layout>
