---
import "./styles.css";
import { getVariantGames } from "../../lib/games";
import { href } from "../../lib/url";
import meta from "./meta";
import { grassTile, svgUrl } from "./pixel";
import ResourceIcon from "./ResourceIcon.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const games = await getVariantGames();
const meadow = `background-image: ${svgUrl(grassTile(11, 64, 3))}`;
---

<!doctype html>
<html lang="de" data-theme={meta.slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body
    class="meadow flex min-h-screen flex-col text-base-content"
    style={meadow}
  >
    <header class="hud wood relative z-10 px-4 py-2">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-2">
        <a
          class="display text-xl text-shell sm:text-2xl"
          href={href(`/${meta.slug}/`)}
        >
          {meta.name}
        </a>
        <ul
          class="order-last flex w-full flex-wrap gap-2 sm:order-none sm:w-auto"
          aria-label="Vorräte"
        >
          <li class="hud-resource">
            <ResourceIcon kind="games" />
            Spiele: <strong>{games.length}</strong>
          </li>
          <li class="hud-resource">
            <ResourceIcon kind="ideas" />
            Ideen: <strong>viele</strong>
          </li>
          <li class="hud-resource">
            <ResourceIcon kind="eggs" />
            Eier: <strong>1 (riesig)</strong>
          </li>
        </ul>
        <nav aria-label="Hauptnavigation" class="ml-auto">
          <ul class="flex gap-2">
            <li>
              <a
                class="btn-game btn-stone"
                href={href(`/${meta.slug}/#spiele`)}
              >
                Spiele
              </a>
            </li>
            <li>
              <a
                class="btn-game btn-stone"
                href={href(`/${meta.slug}/ueber-uns/`)}
              >
                Über uns
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="isolate flex-1 overflow-x-clip">
      <slot />
    </main>
    <footer class="stone relative z-10 rounded-none border-x-0 border-b-0 px-4 py-6 text-center">
      <p>
        «{meta.name}» war einer von mehreren Namensvorschlägen.{" "}
        <a class="link-game" href={href("/fun/")}>
          Alle Vorschläge ansehen
        </a>
      </p>
    </footer>
  </body>
</html>
