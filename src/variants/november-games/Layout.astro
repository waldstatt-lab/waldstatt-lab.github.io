---
import "./styles.css";
import { href } from "../../lib/url";
import meta from "./meta";
import KeyboardControls from "./KeyboardControls.astro";
import SynthwaveScene from "./SynthwaveScene.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const isAbout = Astro.url.pathname.endsWith("/ueber-uns/");
---

<!doctype html>
<html lang="de" data-theme={meta.slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body class="november-site">
    <SynthwaveScene />
    <a class="skip-link" href="#inhalt">
      Zum Inhalt
    </a>
    <header class="site-header shell">
      <a
        class="wordmark"
        href={href(`/${meta.slug}/`)}
        aria-label={`${meta.name} – Startseite`}
      >
        <span class="wordmark-sign" aria-hidden="true">
          N<span>//</span>
        </span>
        <span>
          November
          <br />
          Games<span class="text-primary">.</span>
        </span>
      </a>
      <nav aria-label="Hauptnavigation">
        <ul class="site-nav">
          <li>
            <a href={href(`/${meta.slug}/#spiele`)}>Spiele</a>
          </li>
          <li>
            <a
              href={href(`/${meta.slug}/ueber-uns/`)}
              aria-current={isAbout ? "page" : undefined}
            >
              Über uns
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <KeyboardControls />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <p class="footer-name">
          November Games<span class="text-primary">.</span>
        </p>
        <p>Ein November. Viele Möglichkeiten.</p>
      </div>
      <div class="footer-variants">
        <p>Einer von mehreren Namensvorschlägen.</p>
        <a class="text-link" href={href("/fun/")}>
          Alle Vorschläge ansehen <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
    <script>
      import "./interactions";
    </script>
  </body>
</html>
