---
/** The flask from the organization's avatar, standing in the forest. Decorative. */
interface Props {
  class?: string;
}
const bubbles = [
  { x: 66, r: 4, delay: 0, time: 4.2 },
  { x: 88, r: 3, delay: 1.3, time: 3.4 },
  { x: 104, r: 5, delay: 2.4, time: 4.8 },
  { x: 78, r: 2.5, delay: 3.1, time: 3.8 },
];
---

<svg
  class:list={["flask", Astro.props.class]}
  viewBox="0 0 170 220"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="flask-glass" x1="0" x2="1">
      <stop stop-color="#f3fbe9" stop-opacity=".92"></stop>
      <stop offset=".5" stop-color="#cfe8d6" stop-opacity=".5"></stop>
      <stop offset="1" stop-color="#a9cfc0" stop-opacity=".75"></stop>
    </linearGradient>
    <linearGradient id="flask-liquid" x1="0" x2="1" y2="1">
      <stop stop-color="#3bb5ac"></stop>
      <stop offset=".55" stop-color="#17807f"></stop>
      <stop offset="1" stop-color="#0b5557"></stop>
    </linearGradient>
    <clipPath id="flask-inside">
      <path d="M66 24H104V82L150 188Q154 204 138 204H32Q16 204 20 188L66 82Z"></path>
    </clipPath>
  </defs>
  <ellipse
    cx="96"
    cy="206"
    rx="72"
    ry="11"
    fill="#1d3a1a"
    opacity=".38"
  ></ellipse>
  <path
    d="M66 24H104V82L150 188Q154 204 138 204H32Q16 204 20 188L66 82Z"
    fill="url(#flask-glass)"
  ></path>
  <g clip-path="url(#flask-inside)">
    <rect y="128" width="170" height="80" fill="url(#flask-liquid)"></rect>
    <ellipse cx="85" cy="128" rx="46" ry="6" fill="#6fd3c6"></ellipse>
    {bubbles.map(({ x, r, delay, time }) => (
      <circle
        class="flask-bubble"
        cx={x}
        cy="196"
        r={r}
        fill="#c9f3e6"
        style={`animation-delay: -${delay}s; animation-duration: ${time}s`}
      />
    ))}
    {/* A young fir grows in the flask. */}
    <path d="M83 150V112H87V150Z" fill="#553821"></path>
    <path
      d="M85 34L97 66H91L104 92H95L110 120H60L75 92H66L79 66H73Z"
      fill="#57934f"
    ></path>
    <path d="M85 34L97 66H91L104 92H95L110 120H85Z" fill="#2d6238"></path>
  </g>
  <path
    d="M66 24H104V82L150 188Q154 204 138 204H32Q16 204 20 188L66 82Z"
    fill="none"
    stroke="#eef7e2"
    stroke-width="5"
    stroke-linejoin="round"
  ></path>
  <path
    d="M34 182L70 100"
    stroke="#ffffff"
    stroke-opacity=".75"
    stroke-width="6"
    stroke-linecap="round"
  ></path>
  <rect x="56" y="14" width="58" height="13" rx="4" fill="#eef7e2"></rect>
  <rect x="56" y="22" width="58" height="5" rx="2.5" fill="#b9d8c4"></rect>
</svg>
